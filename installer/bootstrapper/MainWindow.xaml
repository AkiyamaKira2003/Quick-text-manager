<Window x:Class="QuickText.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kira LC Client"
        Width="1652"
        Height="928"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <LinearGradientBrush x:Key="ActiveNavBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#59FF4655" Offset="0" />
      <GradientStop Color="#14FF4655" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Foreground" Value="#F2F2F2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontFamily" Value="Bahnschrift" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NakedButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GoldActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="#121212" />
      <Setter Property="BorderBrush" Value="#FFE7A6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF1A6" Offset="0" />
            <GradientStop Color="#D89D22" Offset="0.5" />
            <GradientStop Color="#8B5E12" Offset="1" />
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="13">
              <Grid ClipToBounds="True">
                <Rectangle Height="18" VerticalAlignment="Top" Fill="#42FFFFFF" />
                <Rectangle Height="18" VerticalAlignment="Bottom" Fill="#26000000" />
                <Border Margin="6" CornerRadius="9" BorderBrush="#66FFF3B0" BorderThickness="1" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background">
                  <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#FFF7C9" Offset="0" />
                      <GradientStop Color="#E8B63D" Offset="0.5" />
                      <GradientStop Color="#9A6A17" Offset="1" />
                    </LinearGradientBrush>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background">
                  <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#B87B18" Offset="0" />
                      <GradientStop Color="#F0B846" Offset="0.55" />
                      <GradientStop Color="#5A3A0B" Offset="1" />
                    </LinearGradientBrush>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolCard" TargetType="Border">
      <Setter Property="Width" Value="320" />
      <Setter Property="Height" Value="120" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="#13FFFFFF" />
      <Setter Property="BorderBrush" Value="#17FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="22" />
    </Style>
  </Window.Resources>

  <Border x:Name="ShellBorder"
          Background="#080C0F"
          BorderBrush="#24FFFFFF"
          BorderThickness="1"
          CornerRadius="18"
          ClipToBounds="True">
    <Grid x:Name="ShellContent" MouseLeftButtonDown="DragWindow" ClipToBounds="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="88" />
        <ColumnDefinition Width="1228" />
        <ColumnDefinition Width="336" />
      </Grid.ColumnDefinitions>

      <Image Grid.ColumnSpan="3"
             Source="Assets/noise-overlay.png"
             Stretch="UniformToFill"
             Opacity="0.16"
             IsHitTestVisible="False" />

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,14,18,0"
                  Panel.ZIndex="50"
                  Grid.ColumnSpan="3">
        <Button Content="-" Width="38" Height="32" Style="{StaticResource ChromeButton}" Click="MinimizeWindow" />
        <Button Content="X" Width="38" Height="32" Style="{StaticResource ChromeButton}" Click="CloseWindow" />
      </StackPanel>

      <Border Grid.Column="0"
              Background="#15171A"
              BorderBrush="#10FFFFFF"
              BorderThickness="0,0,1,0">
        <Canvas Width="88" Height="928">
          <Border Canvas.Left="14" Canvas.Top="24" Width="60" Height="60" CornerRadius="16" ClipToBounds="True" Background="#101318" BorderBrush="#12FFFFFF" BorderThickness="1">
            <Image Source="Assets/kira-lc-sidebar-logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>

          <Button x:Name="HomeNavButton" Canvas.Left="16" Canvas.Top="220" Width="56" Height="56" Style="{StaticResource NakedButton}" Click="SelectLocalSection" Tag="Home">
            <Border CornerRadius="16" Background="#11FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1">
              <TextBlock Text="H" Foreground="#B9C2CC" FontFamily="Bahnschrift" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Button>

          <Button x:Name="ModulesNavButton" Canvas.Left="16" Canvas.Top="284" Width="56" Height="56" Style="{StaticResource NakedButton}" Click="SelectLocalSection" Tag="Modules">
            <Border CornerRadius="16" Background="#0DFFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1">
              <TextBlock Text="M" Foreground="#B9C2CC" FontFamily="Bahnschrift" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Button>

          <Button x:Name="QuickTextNavButton" Canvas.Left="0" Canvas.Top="360" Width="88" Height="80" Style="{StaticResource NakedButton}" Click="SelectQuickTextModule">
            <Border Background="{StaticResource ActiveNavBrush}" BorderBrush="#FF4655" BorderThickness="4,0,0,0">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="QT" Foreground="#FFFFFF" FontFamily="Bahnschrift" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="TEXT" Foreground="#9EA8B3" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </Button>

          <Button x:Name="MacroNavButton" Canvas.Left="16" Canvas.Top="462" Width="56" Height="56" Style="{StaticResource NakedButton}" Click="ShowComingSoon" Tag="Macro for Games">
            <Border CornerRadius="16" Background="#0DFFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1">
              <TextBlock Text="MC" Foreground="#747D86" FontFamily="Bahnschrift" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Button>

          <Button x:Name="BarotemNavButton" Canvas.Left="16" Canvas.Top="526" Width="56" Height="56" Style="{StaticResource NakedButton}" Click="ShowComingSoon" Tag="Auto Notification Barotem">
            <Border CornerRadius="16" Background="#0DFFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1">
              <TextBlock Text="BN" Foreground="#747D86" FontFamily="Bahnschrift" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Button>

          <Button Canvas.Left="16" Canvas.Top="830" Width="56" Height="56" Style="{StaticResource NakedButton}" Click="OpenInstallDialog">
            <Border CornerRadius="16" Background="#0DFFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1">
              <TextBlock Text="SET" Foreground="#9EA8B3" FontFamily="Bahnschrift" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Button>
        </Canvas>
      </Border>

      <Grid Grid.Column="1" Width="1228" Height="928" ClipToBounds="True">
        <Image Source="Assets/quicktext-hero.png"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#F5080C0F" Offset="0" />
              <GradientStop Color="#C2080C0F" Offset="0.38" />
              <GradientStop Color="#33080C0F" Offset="0.75" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#0D080C0F" Offset="0" />
              <GradientStop Color="#EA080C0F" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Image Source="Assets/frame-overlay.png" Stretch="Fill" Opacity="0.22" IsHitTestVisible="False" />

        <Canvas Width="1228" Height="928">
          <Image Canvas.Left="78"
                 Canvas.Top="112"
                 Width="680"
                 Height="126"
                 Source="Assets/header-strip.png"
                 Stretch="Fill"
                 Opacity="0.46"
                 IsHitTestVisible="False" />

          <Grid Canvas.Left="104" Canvas.Top="146" Width="610">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="K I R A  L C"
                       Foreground="#FF4655"
                       FontFamily="Bahnschrift"
                       FontSize="17"
                       FontWeight="Bold" />
            <TextBlock Grid.Row="1"
                       Text="QUICK TEXT"
                       Foreground="#F2F2F2"
                       FontFamily="Bahnschrift"
                       FontSize="56"
                       FontWeight="Black"
                       Margin="0,16,0,0" />
            <TextBlock Grid.Row="2"
                       Width="570"
                       HorizontalAlignment="Left"
                       Text="Create, organize, and trigger reusable text actions instantly. Built for fast workflow, gaming chats, trading messages, and automation-ready input."
                       Foreground="#B8FFFFFF"
                       FontFamily="Segoe UI"
                       FontSize="17"
                       LineHeight="26"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,24,0,0">
              <Button x:Name="InstallButton"
                      Width="244"
                      Height="54"
                      Style="{StaticResource GoldActionButton}"
                      Click="InstallOrLaunch">
                <TextBlock x:Name="LaunchButtonLabel"
                           Text="▶ LAUNCH"
                           Foreground="#111111"
                           FontFamily="Bahnschrift"
                           FontSize="21"
                           FontWeight="Black"
                           TextAlignment="Center" />
              </Button>

              <Button x:Name="ActionMenuButton"
                      Width="54"
                      Height="54"
                      Margin="10,0,0,0"
                      Style="{StaticResource GoldActionButton}"
                      Click="ToggleActionMenu">
                <TextBlock Text="⌄" Foreground="#111111" FontFamily="Bahnschrift" FontSize="24" FontWeight="Black" Margin="0,-5,0,0" />
              </Button>
            </StackPanel>

            <Popup x:Name="ActionMenuPopup"
                   PlacementTarget="{Binding ElementName=ActionMenuButton}"
                   Placement="Bottom"
                   HorizontalOffset="-246"
                   VerticalOffset="10"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
              <Border Width="300" CornerRadius="14" Background="#F0131519" BorderBrush="#2DFFFFFF" BorderThickness="1" Padding="10">
                <StackPanel>
                  <Button Style="{StaticResource NakedButton}" Height="46" Click="OpenInstallDialog">
                    <Border CornerRadius="10" Background="#16FFFFFF" Padding="12,8">
                      <Grid>
                        <TextBlock x:Name="MenuInstallLabel" Text="Install Quick Text" Foreground="#F2F2F2" FontFamily="Bahnschrift" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="Default path, custom path, then download" Foreground="#88FFFFFF" FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,-3" />
                      </Grid>
                    </Border>
                  </Button>
                  <Button x:Name="LaunchMenuButton" Style="{StaticResource NakedButton}" Height="40" Margin="0,7,0,0" Click="LaunchFromMenu">
                    <Border CornerRadius="10" Background="#0DFFFFFF" Padding="12,0">
                      <TextBlock Text="Launch" Foreground="#DFFFFFFF" FontFamily="Bahnschrift" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                    </Border>
                  </Button>
                  <Button x:Name="RepairMenuButton" Style="{StaticResource NakedButton}" Height="40" Margin="0,6,0,0" Click="RepairFromMenu">
                    <Border CornerRadius="10" Background="#0DFFFFFF" Padding="12,0">
                      <TextBlock Text="Repair" Foreground="#DFFFFFFF" FontFamily="Bahnschrift" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                    </Border>
                  </Button>
                  <Button x:Name="UninstallMenuButton" Style="{StaticResource NakedButton}" Height="40" Margin="0,6,0,0" Click="UninstallFromMenu">
                    <Border CornerRadius="10" Background="#19FF4655" Padding="12,0">
                      <TextBlock Text="Uninstall" Foreground="#FFD9DE" FontFamily="Bahnschrift" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                    </Border>
                  </Button>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>

          <Image Canvas.Left="86"
                 Canvas.Top="382"
                 Width="660"
                 Height="156"
                 Source="Assets/header-glow.png"
                 Stretch="Fill"
                 Opacity="0.72"
                 IsHitTestVisible="False" />

          <TextBlock Canvas.Left="102" Canvas.Top="560"
                     Width="540"
                     Text="Quick Text helps you create, organize, and trigger reusable text actions instantly. Built for fast workflow, gaming chats, trading messages, and automation-ready input."
                     Foreground="#B3FFFFFF"
                     FontFamily="Segoe UI"
                     FontSize="18"
                     FontWeight="SemiBold"
                     LineHeight="28"
                     TextWrapping="Wrap" />

          <Border x:Name="ModuleCardPanel" Canvas.Left="102" Canvas.Top="770" Style="{StaticResource ToolCard}" ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="OpenQuickTextFeature" Tag="Preset Library">
            <Grid>
              <Image x:Name="SceneImageA" Stretch="UniformToFill" Opacity="0.62" RenderOptions.BitmapScalingMode="HighQuality" />
              <Image x:Name="SceneImageB" Stretch="UniformToFill" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality" />
              <Rectangle Fill="#B5080C0F" />
              <StackPanel>
                <TextBlock Text="Preset Library" Foreground="#F2F2F2" FontFamily="Bahnschrift" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="Reusable snippets, profiles, and module-ready text groups." Foreground="#D8FFFFFF" FontFamily="Segoe UI" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,10,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <Border x:Name="HotkeyCardPanel" Canvas.Left="450" Canvas.Top="770" Style="{StaticResource ToolCard}" ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="OpenQuickTextFeature" Tag="Hotkey Manager">
            <Grid>
              <Image Source="Assets/success-scene.png" Stretch="UniformToFill" Opacity="0.58" RenderOptions.BitmapScalingMode="HighQuality" />
              <Rectangle Fill="#B5080C0F" />
              <StackPanel>
                <TextBlock Text="Hotkey Manager" Foreground="#F2F2F2" FontFamily="Bahnschrift" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="Packaged Electron hotkeys with native input fallback." Foreground="#D8FFFFFF" FontFamily="Segoe UI" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,10,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <Border x:Name="ClipboardCardPanel" Canvas.Left="798" Canvas.Top="770" Style="{StaticResource ToolCard}" ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="OpenQuickTextFeature" Tag="Clipboard Actions">
            <Grid>
              <Image Source="Assets/error-scene.png" Stretch="UniformToFill" Opacity="0.54" RenderOptions.BitmapScalingMode="HighQuality" />
              <Rectangle Fill="#B5080C0F" />
              <StackPanel>
                <TextBlock Text="Clipboard Actions" Foreground="#F2F2F2" FontFamily="Bahnschrift" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="Fast paste, overlay tools, and automation-ready send flow." Foreground="#D8FFFFFF" FontFamily="Segoe UI" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,10,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </Canvas>
      </Grid>

      <Border Grid.Column="2"
              Width="312"
              Height="864"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,32,16,0"
              CornerRadius="18"
              Background="#E0141416"
              BorderBrush="#14FFFFFF"
              BorderThickness="1">
        <Grid Margin="20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="KIRA LC" Foreground="#F2F2F2" FontFamily="Bahnschrift" FontSize="20" FontWeight="Black" />
            <TextBlock Text="Client shell / Quick Text module" Foreground="#A3FFFFFF" FontFamily="Segoe UI" FontSize="12" Margin="0,4,0,0" />
          </StackPanel>

          <Border Grid.Row="1" Height="430" CornerRadius="18" Background="#0B0B0D" BorderBrush="#18FFFFFF" BorderThickness="1" ClipToBounds="True" Margin="0,18,0,0">
            <Grid>
              <Image x:Name="HeroImageA" Stretch="Uniform" Opacity="1" RenderOptions.BitmapScalingMode="HighQuality" />
              <Image x:Name="HeroImageB" Stretch="Uniform" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality" />
              <Rectangle>
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#18000000" Offset="0.62" />
                    <GradientStop Color="#D6080C0F" Offset="1" />
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Image Source="Assets/frame-overlay.png" Stretch="Fill" Opacity="0.22" IsHitTestVisible="False" />
              <Border HorizontalAlignment="Left"
                      VerticalAlignment="Bottom"
                      Margin="14"
                      Padding="11,8"
                      CornerRadius="16"
                      Background="#D10A0D10"
                      BorderBrush="#2DFFFFFF"
                      BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse x:Name="StatusDot"
                           Width="9"
                           Height="9"
                           Fill="#D6AA4F"
                           VerticalAlignment="Center" />
                  <TextBlock x:Name="StatusText"
                             Text="Ready to install."
                             Foreground="#F2F2F2"
                             FontFamily="Bahnschrift"
                             FontSize="13"
                             FontWeight="Bold"
                             Margin="9,0,0,0"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="214" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <StackPanel Grid.Row="2" Margin="0,22,0,0">
            <TextBlock Text="M O D U L E S" Foreground="#8EFFFFFF" FontFamily="Bahnschrift" FontSize="12" FontWeight="Bold" />

            <Border x:Name="QuickTextModuleItem" Background="#1FFF4655" BorderBrush="#FF4655" BorderThickness="3,0,0,0" CornerRadius="8" Padding="10" Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonUp="SelectQuickTextModuleFromPanel">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Quick Text" Foreground="#F2F2F2" FontFamily="Bahnschrift" FontSize="15" FontWeight="Bold" />
                <TextBlock x:Name="QuickTextModuleState" Grid.Column="1" Text="Active" Foreground="#FF7884" FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold" />
              </Grid>
            </Border>

            <Border Background="#0AFFFFFF" CornerRadius="8" Padding="10" Margin="0,8,0,0" Opacity="0.45" Cursor="Hand" MouseLeftButtonUp="ShowComingSoonFromPanel" Tag="Macro for Games">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Macro for Games" Foreground="#F2F2F2" FontFamily="Bahnschrift" FontSize="14" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="Soon" Foreground="#A3FFFFFF" FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold" />
              </Grid>
            </Border>

            <Border Background="#0AFFFFFF" CornerRadius="8" Padding="10" Margin="0,8,0,0" Opacity="0.45" Cursor="Hand" MouseLeftButtonUp="ShowComingSoonFromPanel" Tag="Auto Notification Barotem">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Auto Notification Barotem" Foreground="#F2F2F2" FontFamily="Bahnschrift" FontSize="13" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="Planned" Foreground="#A3FFFFFF" FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold" />
              </Grid>
            </Border>

            <TextBlock Text="L I F E C Y C L E"
                       Foreground="#8EFFFFFF"
                       FontFamily="Bahnschrift"
                       FontSize="12"
                       FontWeight="Bold"
                       Visibility="Collapsed"
                       Margin="0,18,0,0" />
            <UniformGrid Columns="4" Rows="1" Margin="0,10,0,0" Visibility="Collapsed">
              <Border x:Name="InstallStateButton" Height="70" Margin="0,0,6,0" CornerRadius="10" Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="InstallLifecycleClicked">
                <Grid>
                  <Image Source="Assets/install-hero.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                  <Rectangle Fill="#3A000000" />
                  <TextBlock Text="INSTALL" Foreground="#F2F2F2" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                </Grid>
              </Border>
              <Border x:Name="RemoveStateButton" Height="70" Margin="0,0,6,0" CornerRadius="10" Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="RemoveLifecycleClicked">
                <Grid>
                  <Image Source="Assets/uninstall-hero.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                  <Rectangle Fill="#3A000000" />
                  <TextBlock Text="REMOVE" Foreground="#F2F2F2" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                </Grid>
              </Border>
              <Border x:Name="ReadyStateButton" Height="70" Margin="0,0,6,0" CornerRadius="10" Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="ReadyLifecycleClicked">
                <Grid>
                  <Image Source="Assets/success-hero.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                  <Rectangle Fill="#30000000" />
                  <TextBlock Text="READY" Foreground="#F2F2F2" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                </Grid>
              </Border>
              <Border x:Name="ErrorStateButton" Height="70" CornerRadius="10" Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="ErrorLifecycleClicked">
                <Grid>
                  <Image Source="Assets/error-hero.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                  <Rectangle Fill="#3A000000" />
                  <TextBlock Text="ERROR" Foreground="#F2F2F2" FontFamily="Bahnschrift" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                </Grid>
              </Border>
            </UniformGrid>
          </StackPanel>

          <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="S E T U P" Foreground="#8EFFFFFF" FontFamily="Bahnschrift" FontSize="12" FontWeight="Bold" />
            <Border CornerRadius="12"
                    Background="#0DFFFFFF"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,10,0,0"
                    Cursor="Hand"
                    MouseLeftButtonUp="OpenInstallDialogFromPanel">
              <StackPanel>
                <TextBlock Text="Install target" Foreground="#F2F2F2" FontFamily="Bahnschrift" FontSize="13" FontWeight="Bold" />
                <TextBlock x:Name="InstallPathPreviewText"
                           Text="Default install path"
                           Foreground="#A8FFFFFF"
                           FontFamily="Consolas"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0" />
                <TextBlock Text="Click to review path before downloading"
                           Foreground="#75FFFFFF"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Margin="0,7,0,0" />
              </StackPanel>
            </Border>
            <TextBox x:Name="InstallPathBox"
                     Height="42"
                     Margin="0,10,0,0"
                     Padding="12,9"
                     Background="#E80B1015"
                     BorderBrush="#28FFFFFF"
                     Foreground="#F2F2F2"
                     CaretBrush="#FF4655"
                     FontFamily="Consolas"
                     FontSize="12"
                     Visibility="Collapsed" />

            <Grid Visibility="Collapsed">
              <Image x:Name="CoreImageA" Stretch="UniformToFill" Opacity="1" RenderOptions.BitmapScalingMode="HighQuality" />
              <Image x:Name="CoreImageB" Stretch="UniformToFill" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality" />
              <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#D6AA4F" Background="#20252A" BorderBrush="#33FFFFFF" />
              <TextBlock x:Name="ProgressText" Text="Waiting for launch confirmation" Foreground="#9FFFFFFF" FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap" />
              <StackPanel x:Name="ActivityLogPanel" />
            </Grid>
          </StackPanel>

          <TextBlock x:Name="StepText"
                     Grid.Row="4"
                     Text="Engine: embedded Quick Text setup core"
                     Foreground="#7DFFFFFF"
                     FontFamily="Segoe UI"
                     FontSize="12"
                     Visibility="Collapsed"
                     TextWrapping="Wrap" />
        </Grid>
      </Border>

      <Grid x:Name="InstallPathDialog"
            Grid.ColumnSpan="3"
            Panel.ZIndex="80"
            Visibility="Collapsed">
        <Rectangle Fill="#B805070A" />
        <Border Width="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="18"
                Background="#F014171B"
                BorderBrush="#32FFFFFF"
                BorderThickness="1"
                Padding="24">
          <StackPanel>
            <TextBlock x:Name="InstallDialogTitle"
                       Text="Install Quick Text"
                       Foreground="#F2F2F2"
                       FontFamily="Bahnschrift"
                       FontSize="24"
                       FontWeight="Black" />
            <TextBlock x:Name="InstallDialogBody"
                       Text="Quick Text will be installed to the default path below. You can choose a custom folder before downloading."
                       Foreground="#A8FFFFFF"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <Border CornerRadius="12" Background="#E80B1015" BorderBrush="#28FFFFFF" BorderThickness="1" Padding="12" Margin="0,18,0,0">
              <StackPanel>
                <TextBlock Text="Install path" Foreground="#80FFFFFF" FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold" />
                <TextBox x:Name="InstallDialogPathBox"
                         Margin="0,7,0,0"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         Foreground="#F2F2F2"
                         CaretBrush="#FF4655"
                         FontFamily="Consolas"
                         FontSize="13"
                         IsReadOnly="True"
                         TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Style="{StaticResource NakedButton}" HorizontalAlignment="Left" Click="LocateExistingInstall">
                <TextBlock Text="File đã có sẵn? Bấm vào đây"
                           Foreground="#8FFFFFFF"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           TextDecorations="Underline" />
              </Button>
              <Button x:Name="InstallDialogBrowseButton"
                      Grid.Column="1"
                      Width="136"
                      Height="38"
                      Style="{StaticResource NakedButton}"
                      Click="BrowsePathFromDialog">
                <Border CornerRadius="10" Background="#12FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                  <TextBlock Text="Custom path" Foreground="#DFFFFFFF" FontFamily="Bahnschrift" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Button>
            </Grid>

            <Grid Margin="0,22,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="142" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="1" Height="42" Style="{StaticResource NakedButton}" Click="CloseInstallDialog">
                <Border CornerRadius="12" Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1">
                  <TextBlock Text="Cancel" Foreground="#BFFFFFFF" FontFamily="Bahnschrift" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Button>
              <Button x:Name="InstallDialogPrimaryButton"
                      Grid.Column="2"
                      Height="42"
                      Margin="10,0,0,0"
                      Style="{StaticResource NakedButton}"
                      Click="ConfirmInstallFromDialog">
                <Border CornerRadius="12" Background="#D6AA4F" BorderBrush="#FFE7A6" BorderThickness="1">
                  <TextBlock x:Name="InstallDialogPrimaryLabel"
                             Text="TẢI VỀ"
                             Foreground="#111111"
                             FontFamily="Bahnschrift"
                             FontSize="14"
                             FontWeight="Black"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
