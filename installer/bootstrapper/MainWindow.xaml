<Window x:Class="QuickText.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kira LC Setup"
        Width="1180"
        Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#050812">
  <Window.Resources>
    <LinearGradientBrush x:Key="PanelGlow" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#122C58" Offset="0" />
      <GradientStop Color="#0A1024" Offset="0.46" />
      <GradientStop Color="#2A0D24" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Foreground" Value="#C8F6FF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontFamily" Value="Bahnschrift" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#305BFF" BorderThickness="1" Background="#050812">
    <Grid MouseLeftButtonDown="DragWindow">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="620" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Image Grid.ColumnSpan="2"
             Source="Assets/install-hero.png"
             Stretch="UniformToFill"
             Opacity="0.18" />
      <Rectangle Grid.ColumnSpan="2">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.78,0.46" GradientOrigin="0.78,0.46" RadiusX="0.78" RadiusY="0.72">
            <GradientStop Color="#221D55FF" Offset="0" />
            <GradientStop Color="#BB050812" Offset="0.62" />
            <GradientStop Color="#F4050812" Offset="1" />
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,18,18,0"
                  Grid.ColumnSpan="2">
        <Button Content="-" Width="38" Height="32" Style="{StaticResource ChromeButton}" Click="MinimizeWindow" />
        <Button Content="X" Width="38" Height="32" Style="{StaticResource ChromeButton}" Click="CloseWindow" />
      </StackPanel>

      <Grid Grid.Column="0" Margin="54,48,32,44">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
          <Border Width="430"
                  Height="176"
                  HorizontalAlignment="Left"
                  Background="#D9050812"
                  BorderBrush="#394C69"
                  BorderThickness="1"
                  CornerRadius="22"
                  ClipToBounds="True"
                  Effect="{StaticResource NeonPinkShadow}">
            <Grid>
              <Image Source="Assets/kira-lc-logo.png"
                     Stretch="UniformToFill"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <Rectangle>
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#44050812" Offset="0" />
                    <GradientStop Color="#00050812" Offset="0.52" />
                    <GradientStop Color="#66050812" Offset="1" />
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
            </Grid>
          </Border>
          <TextBlock Text="KIRA LC CLIENT"
                     Margin="2,14,0,0"
                     Foreground="#F5D7A5"
                     FontFamily="Bahnschrift"
                     FontSize="13"
                     FontWeight="Bold" />
          <TextBlock Text="QUICK TEXT MODULE"
                     Margin="2,6,0,0"
                     Foreground="#6EEBFF"
                     FontFamily="Bahnschrift"
                     FontSize="13"
                     FontWeight="Bold" />
          <TextBlock Text="Cài Quick Text qua launcher riêng"
                     Margin="0,8,0,0"
                     Foreground="#F7FCFF"
                     FontFamily="Bahnschrift"
                     FontSize="42"
                     FontWeight="Bold"
                     TextWrapping="Wrap"
                     LineHeight="46" />
          <TextBlock Text="Kira LC là shell cài đặt kiểu game client. Quick Text là app module bên trong, được đóng gói cùng runtime, hotkey backend và Python service."
                     Margin="0,18,18,0"
                     Foreground="#B9C9DE"
                     FontFamily="Segoe UI"
                     FontSize="16"
                     TextWrapping="Wrap"
                     LineHeight="24" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,36,0,0"
                Padding="22"
                VerticalAlignment="Top"
                Background="#9A07101F"
                BorderBrush="#263F6D"
                BorderThickness="1"
                CornerRadius="24">
          <StackPanel>
            <TextBlock Text="Install directory"
                       Foreground="#DDF9FF"
                       FontFamily="Bahnschrift"
                       FontSize="15"
                       FontWeight="Bold" />
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="InstallPathBox"
                       Height="42"
                       Padding="14,10"
                       Background="#E80B1326"
                       BorderBrush="#355E9A"
                       Foreground="#EEF9FF"
                       CaretBrush="#68E8FF"
                       FontFamily="Consolas"
                       FontSize="13" />
              <Button Grid.Column="1"
                      Margin="12,0,0,0"
                      Content="Browse"
                      Height="42"
                      Style="{StaticResource ChromeButton}"
                      Background="#152B51"
                      Click="BrowseInstallPath" />
            </Grid>

            <TextBlock x:Name="StatusText"
                       Text="Ready to install."
                       Margin="0,24,0,0"
                       Foreground="#8CEEFF"
                       FontFamily="Bahnschrift"
                       FontSize="14"
                       FontWeight="Bold" />
            <ProgressBar x:Name="InstallProgress"
                         Height="10"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Margin="0,10,0,0"
                         Foreground="#5EE7FF"
                         Background="#10192B"
                         BorderBrush="#2B4168" />
            <TextBlock x:Name="ProgressText"
                       Text="Waiting for confirmation"
                       Margin="0,10,0,0"
                       Foreground="#7D8BA3"
                       FontFamily="Segoe UI"
                       FontSize="13" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StepText"
                     Text="Engine: Kira LC UI + embedded Quick Text setup core"
                     VerticalAlignment="Center"
                     Foreground="#708098"
                     FontFamily="Segoe UI"
                     FontSize="13" />
          <Button x:Name="InstallButton"
                  Grid.Column="1"
                  Content="Install Quick Text"
                  MinWidth="196"
                  Height="54"
                  Padding="22,0"
                  Background="#1FCFFF"
                  Foreground="#03111C"
                  FontFamily="Bahnschrift"
                  FontSize="16"
                  FontWeight="Bold"
                  BorderBrush="#8BF5FF"
                  Cursor="Hand"
                  Click="InstallOrLaunch" />
        </Grid>
      </Grid>

      <Grid Grid.Column="1" Margin="0,54,48,54">
        <Border Background="{StaticResource PanelGlow}"
                BorderBrush="#335BFF"
                BorderThickness="1"
                CornerRadius="34"
                Effect="{StaticResource NeonPinkShadow}" />
        <Image Source="Assets/install-hero.png"
               Stretch="UniformToFill"
               Margin="1"
               ClipToBounds="True"
               Opacity="0.96" />
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#00000000" Offset="0" />
              <GradientStop Color="#77050812" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <TextBlock Text="QUICK TEXT MODULE"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="36,0,0,44"
                   Foreground="#EAFBFF"
                   FontFamily="Bahnschrift"
                   FontSize="22"
                   FontWeight="Bold"
                   Effect="{StaticResource NeonCyanShadow}" />
      </Grid>
    </Grid>
  </Border>
</Window>
