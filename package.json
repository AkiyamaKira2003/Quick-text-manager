{
  "name": "quicktext",
  "version": "2.0.1",
  "description": "Quick Text desktop app for instant snippets and productivity overlays.",
  "author": "Kira",
  "homepage": "https://github.com/AkiyamaKira2003/Quick-text-manager",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run dev:free-port && concurrently --kill-others --success first --names NEXT,ELECTRON --prefix-colors cyan,magenta \"npm run dev:next\" \"npm run dev:electron\"",
    "dev:fast": "npm run dev:free-port && concurrently --kill-others --success first --names NEXT,ELECTRON --prefix-colors cyan,magenta \"npm run dev:next:turbo\" \"npm run dev:electron\"",
    "dev:cold": "npm run dev:free-port && npm run dev:clean-next && concurrently --kill-others --success first --names NEXT,ELECTRON --prefix-colors cyan,magenta \"npm run dev:next\" \"npm run dev:electron\"",
    "dev:clean-next": "node scripts/clean-next-dev.mjs",
    "dev:free-port": "node scripts/free-port.mjs 3000",
    "dev:next": "set QT_NEXT_DIST_DIR=.next-dev&& next dev --webpack -p 3000",
    "dev:next:turbo": "set QT_NEXT_DIST_DIR=.next-dev&& next dev -p 3000",
    "serve:next": "set QT_NEXT_DIST_DIR=.next&& next start -p 3000",
    "run:local": "npm run dev:free-port && concurrently --kill-others --success first --names NEXT,ELECTRON --prefix-colors cyan,magenta \"npm run serve:next\" \"npm run dev:electron\"",
    "dev:python": "py python/tool.py",
    "dev:electron": "wait-on tcp:3000 && node scripts/start-electron.cjs",
    "build": "next build",
    "analyze:bundle": "set ANALYZE=true&& next build --webpack",
    "report:main-bundle": "node scripts/report-main-bundle.mjs",
    "report:overlay-bundle": "node scripts/report-overlay-bundle.mjs",
    "qa:prod": "npm run build && npm run run:local",
    "build:standalone": "node scripts/prepare-standalone.cjs",
    "build:win-icon": "node scripts/prepare-win-icon.cjs",
    "build:python-service": "node scripts/build-python-service.mjs",
    "build:native-core": "node scripts/build-native-core.mjs",
    "release:launcher:manifest": "node scripts/generate-launcher-manifest.mjs",
    "release:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher-release.ps1",
    "release:launcher:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher-exe.ps1",
    "test": "node scripts/run-tests.mjs",
    "test:ci": "node scripts/run-tests.mjs",
    "test:prod": "npm run build && npm run run:local",
    "dist:win": "set QT_NEXT_DIST_DIR=.next-build&& next build && node scripts/prepare-standalone.cjs && node scripts/prepare-win-icon.cjs && npm run build:native-core && electron-builder --win nsis",
    "dist:folder": "set QT_NEXT_DIST_DIR=.next-build&& next build && node scripts/prepare-standalone.cjs && node scripts/prepare-win-icon.cjs && npm run build:native-core && electron-builder --win dir",
    "start": "next start",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.quicktext.desktop",
    "productName": "Quick Text",
    "executableName": "QuickText",
    "copyright": "Copyright © 2026 Kira",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "lib/**/*.js",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "public/**",
      "electron/native/build/Release/**"
    ],
    "extraResources": [
      {
        "from": ".next-build/standalone-runtime",
        "to": ".next-build/standalone-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "QuickText-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Quick Text",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Quick Text",
      "installerIcon": "build/installer.ico",
      "uninstallerIcon": "build/uninstaller.ico",
      "installerHeaderIcon": "build/installerHeader.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "license": "installer/LICENSE-setup.txt",
      "include": "installer/installer.nsh",
      "warningsAsErrors": false
    }
  },
  "dependencies": {
    "@google-cloud/translate": "^9.3.0",
    "@google-cloud/vision": "^5.3.5",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "argparse": "2.0.1",
    "autoprefixer": "^10.4.20",
    "builder-util-runtime": "9.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "debug": "4.3.4",
    "electron-updater": "^6.6.2",
    "embla-carousel-react": "8.6.0",
    "fs-extra": "10.1.0",
    "graceful-fs": "4.2.11",
    "input-otp": "1.4.2",
    "js-yaml": "4.1.1",
    "jsonfile": "6.2.0",
    "lazy-val": "1.0.5",
    "lodash.escaperegexp": "4.1.2",
    "lodash.isequal": "4.5.0",
    "lucide-react": "^0.564.0",
    "ms": "2.1.3",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-day-picker": "9.13.2",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.0",
    "sax": "1.2.4",
    "semver": "7.7.3",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^7.0.0",
    "tiny-typed-emitter": "2.1.0",
    "universalify": "2.0.1",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.1",
    "electron": "29.4.6",
    "electron-builder": "^24.13.3",
    "eslint": "^9.23.0",
    "node-addon-api": "^8.2.0",
    "node-gyp": "^12.2.0",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "wait-on": "7.2.0"
  }
}
